{
  "expo": {
    "name": "Zelo",
    "slug": "zelo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zelo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.zelo",
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1C1B19",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.zelo"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Zelo utilise ta position pour centrer la carte et placer tes signalements."
        }
      ],
      "expo-sqlite",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "GoogleSansFlex",
                "path": "./assets/fonts/GoogleSansFlex.ttf",
                "fontDefinitions": [
                  {
                    "weight": 400
                  },
                  {
                    "weight": 500
                  },
                  {
                    "weight": 600
                  },
                  {
                    "weight": 700
                  }
                ]
              }
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "platforms": [
      "ios",
      "android"
    ]
  }
}
